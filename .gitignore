# KiCad
*-backups/
.history/
_autosave-*
*.kicad_prl
*.lck
fp-info-cache
~*.lck

# LaTeX build byproducts (audit/paper)
*.aux
*.bbl
*.blg
*.out

# Simulation artifacts
*.raw
sim.log
*.log
!**/evidence/**/*.log
!tests/fixtures/**/*.log

# Node / Python
node_modules/
__pycache__/
*.pyc
.venv/

# OS
Thumbs.db
.DS_Store

# Run output (builds live in their own repos; harness repo stays clean).
# Anchored to repo root — .claude/commands/anvil/ etc. must stay tracked.
/anvil/
/build-output/
/boards/
/forge/

# Reference library (copyrighted books/standards) is local-only; only extracted rulebooks are tracked.
references/*.pdf
references/*.epub
